# ----------------------------------------------------------------------------
# GRANJA OLIVEIRA — FRONT-END — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com valores reais.
# NUNCA cometa o arquivo ".env.local" no controle de versão.
# ----------------------------------------------------------------------------

# Onde o back-end está rodando. O front repassa /api/* para este endereço.
# (Lida no BUILD e em runtime — defina também no ambiente de build/deploy.)
BACKEND_URL="http://localhost:3001"

# URL PÚBLICA deste front-end (a que o usuário abre no navegador).
# Deve ser IDÊNTICA ao NEXTAUTH_URL do back-end.
NEXTAUTH_URL="http://localhost:3000"

# Segredo de assinatura da sessão. DEVE SER IDÊNTICO ao NEXTAUTH_SECRET do
# back-end: o back-end assina o cookie de sessão no login e o front o lê
# (middleware e layouts) para saber quem está logado.
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-forte"
