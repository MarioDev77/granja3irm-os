# ----------------------------------------------------------------------------
# GRANJA OLIVEIRA — BACK-END — Variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" no controle de versão.
# ----------------------------------------------------------------------------

# String de conexão do PostgreSQL (Railway: aba "Connect" do serviço Postgres,
# use a "Postgres Connection URL" pública ou a interna se o app rodar no
# mesmo projeto Railway).
DATABASE_URL="postgresql://usuario:senha@host:5432/granja_oliveira"

# Opcional: credencial separada para migrações, com privilégios de DDL.
# Em produção, mantenha a DATABASE_URL da aplicação com privilégios mínimos.
DATABASE_MIGRATION_URL=""

# NextAuth — IMPORTANTE: aqui vai a URL PÚBLICA DO FRONT-END (o endereço que o
# usuário abre no navegador), não a URL do back-end. É a partir dela que o
# back-end monta links (redefinição de senha, QR Code dos galpões) e decide o
# nome do cookie de sessão (com "https" o cookie ganha o prefixo __Secure-).
NEXTAUTH_URL="http://localhost:3000"

# Segredo de assinatura da sessão. DEVE SER IDÊNTICO ao NEXTAUTH_SECRET do
# front-end, senão o front não consegue ler a sessão criada pelo back.
# Gere um segredo forte com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-forte"

# Serviço de envio do link de redefinição de senha (backend-only).
# Deve aceitar POST JSON { email, resetUrl } com Authorization: Bearer <token>.
# Em produção, PASSWORD_RESET_DELIVERY_URL precisa usar HTTPS.
PASSWORD_RESET_DELIVERY_URL=""
PASSWORD_RESET_DELIVERY_TOKEN=""

# Dados do primeiro administrador, usados apenas pelo script de seed
# (sql/seed.js) para criar a primeira conta de acesso. Depois do primeiro
# login, altere a senha e/ou crie outros administradores pelo sistema.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@granjaoliveira.com.br"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte-antes-do-seed"
